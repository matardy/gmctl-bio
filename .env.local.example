NVIDIA_API_KEY=nvapi-...
OPENROUTER_API_KEY=sk-or-v1-...
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (service role — never expose to client)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Supabase local development
# Start local stack with: npx supabase start
# Reset/apply local migrations with: npx supabase db reset
# Typical local values:
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_ROLE_KEY=<printed by `npx supabase start`>

# Langfuse (observability — server only)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Chat quota + moderation
CHAT_TOKENS_LIMIT_24H=12000
CHAT_MODERATION_EVERY_N_USER_MESSAGES=8
CHAT_MODERATION_PROVIDER=openrouter
CHAT_MODERATION_MODEL=meta-llama/llama-3.3-70b-instruct:free
CHAT_MODERATION_TIMEOUT_MS=4000
VISITOR_COOKIE_SIGNING_SECRET=replace-me
