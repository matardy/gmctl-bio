# OpenRouter (server only) — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Optional: app attribution URL shown in the OpenRouter dashboard.
# OPENROUTER_SITE_URL=https://gutemberg.dev

# Postgres
# Local: `npm run db:up` (Docker, port 5433) then `npm run db:migrate`.
# Production (Neon): use the pooled (-pooler) URL here and the direct URL in
# DATABASE_URL_UNPOOLED (used only by the migration runner).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/personal_web
# DATABASE_URL_UNPOOLED=
# Max connections per app process (default 5).
# DATABASE_POOL_MAX=5

# Langfuse (observability — server only)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Chat quota + moderation
CHAT_TOKENS_LIMIT_24H=100000
CHAT_MODERATION_EVERY_N_USER_MESSAGES=8
CHAT_MODERATION_MODEL=anthropic/claude-haiku-5.5
# Model for navigation quips (cheap + fast).
CHAT_QUIP_MODEL=mistralai/mistral-small-3.2-24b-instruct
CHAT_MODERATION_TIMEOUT_MS=4000
