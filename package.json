{
  "name": "personal-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.9.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:psql": "docker exec -it personal-web-db psql -U postgres -d personal_web"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/pg": "^8.23.1",
    "jsdom": "^27.0.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@copilotkit/react-core": "^1.62.3",
    "@copilotkit/react-ui": "^1.62.3",
    "@copilotkit/runtime": "^1.62.3",
    "@copilotkit/sdk-js": "^1.62.3",
    "@langchain/core": "^1.3.2",
    "@langchain/openai": "^1.5.5",
    "@langchain/openrouter": "^0.4.21",
    "@langfuse/langchain": "^5.9.1",
    "@langfuse/otel": "^5.2.0",
    "@opentelemetry/sdk-node": "^0.217.0",
    "@opentelemetry/sdk-trace-node": "^2.7.0",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "langchain": "^1.5.3",
    "next": "^16.2.4",
    "pg": "^8.23.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^6.0.3"
  }
}
